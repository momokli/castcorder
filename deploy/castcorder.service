[Unit]
Description=Castcorder (live DJ encoder)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=castcorder
Group=castcorder
SupplementaryGroups=audio gpio
WorkingDirectory=/opt/castcorder
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/castcorder
EnvironmentFile=-/etc/castcorder/streamer.env
StateDirectory=castcorder
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -m castcorder --config /etc/castcorder/config.toml
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 3
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
