[Unit]
Description=radio zukka Wuerfel (live DJ encoder)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=zukka
Group=zukka
SupplementaryGroups=audio gpio
WorkingDirectory=/opt/zukka-wuerfel
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/zukka-wuerfel
EnvironmentFile=-/etc/zukka-wuerfel/streamer.env
StateDirectory=zukka-wuerfel
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -m zukka_wuerfel --config /etc/zukka-wuerfel/config.toml
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 3
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
